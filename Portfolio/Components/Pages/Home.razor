@page "/"

<PageTitle>Portfolio</PageTitle>

<main class="page">
    <header class="intro">
        <h1>Jeb</h1>
        <p class="role">Beginner Developer · Stack : C#, Python, .NET, PostgreSql, Sqlite</p>
        <hr class="trim" />
        <p class="lede">
            I like building applications people can use with .NET
        </p>
    </header>

    <section aria-labelledby="work-heading">
        <h2 id="work-heading">Work</h2>
        <ul class="work">
            @foreach (var project in Projects)
            {
                <li>
                    <a href="@project.Url">
                        <h3>@project.Name</h3>
                        <span class="year">@project.Year</span>
                        <p>@project.Summary</p>
                        <span class="stack">@string.Join(" · ", project.Stack)</span>
                    </a>
                </li>
            }
        </ul>
    </section>

    <section aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact</h2>
        <ul class="contact">
            <li><a href="">CV</a></li>
            <li><a href="https://github.com/tk-wk" rel="noopener">GitHub</a></li>
            <li><a href="https://www.linkedin.com/" rel="noopener">LinkedIn</a></li>
        </ul>
    </section>
</main>

@code {
    private sealed record Project(string Name, string Year, string Summary, string[] Stack, string Url);

    // Sample entries. Swap the summaries and links for the real ones.
    private static readonly Project[] Projects =
    [
        new("Indexed", "2026",
            "An AI-powered multiplatform flashcard app for students, by a fellow student.",
            ["C#", "ASP.NET Core", "Blazor Hybrid", "MudBlazor", "SQLite", "PostgreSQL"], "#"),
        new("Last Letter", "2026",
            "A real-time multiplayer word game for the browser.",
            ["ASP.NET Core", "Blazor WebAssembly", "SignalR"], "https://lastletter-tkwk.spinelly.net"),
    ];
}
